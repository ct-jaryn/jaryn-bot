# DeepSeek API (required for real model; omit to use echo provider)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# Optional API auth: if set, /api/* requires Authorization: Bearer <token>
# JARY_API_TOKEN=
# Optional inbound email webhook secret
# JARY_EMAIL_SECRET=

# Optional: mount a Docker socket only if you want the container sandbox
# JARY_AUTO_APPROVE=0

# Optional IMAP inbox polling (config via patch: packages/bundles/email-imap/patch.json)
# IMAP_HOST=imap.example.com
# IMAP_USER=bot@example.com
# IMAP_PASS=...
