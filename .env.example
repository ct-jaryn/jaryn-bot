# DeepSeek API (required for real model; omit to use echo provider)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# Optional API auth: if set, /api/* requires Authorization: Bearer <token>
# JARY_API_TOKEN=
# Optional inbound email webhook secret
# JARY_EMAIL_SECRET=

# Optional OAuth connectors (set all four per connector id, e.g. GMAIL)
# JARY_OAUTH_CLIENT_ID_GMAIL=
# JARY_OAUTH_CLIENT_SECRET_GMAIL=
# JARY_OAUTH_TOKEN_URL_GMAIL=https://oauth2.googleapis.com/token
# JARY_OAUTH_STATE_GMAIL=<random-string>

# Vault master key (auto-generated at $JARY_HOME/vault.key if omitted)
# JARY_VAULT_KEY=

# Export sessions with secrets in clear text (default: redacted)
# JARY_EXPORT_RAW=0

# SMTP / IMAP are configured through patches, not env:
#   packages/bundles/email-imap/patch.json  (imap host/user/pass)
#   examples/connectors/*.json              (connectors)
